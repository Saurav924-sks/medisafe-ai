# SMART on FHIR server configuration (keep real values in the local .env only)
APP_ENV=development
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-managed-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medisafe_db
# Optional for isolated local development; PostgreSQL is the configured default.
# DATABASE_URL=sqlite:///./medisafe-local.db
SECRET_KEY=replace-with-random-secret-if-required
API_KEY=replace-with-organization-credential
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FHIR_BASE_URL=https://fhir.example.invalid
FHIR_CLIENT_ID=replace-with-registered-client-id
FHIR_CLIENT_SECRET=
FHIR_SCOPES=launch/patient openid fhirUser offline_access patient/*.read user/Practitioner.read
FHIR_REDIRECT_URI=https://app.example.invalid/api/v1/fhir/smart/callback
FHIR_CONTEXT_MAX_AGE_HOURS=24
